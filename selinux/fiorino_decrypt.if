
## <summary>policy for fiorino_decrypt</summary>

########################################
## <summary>
##	Execute fiorino_decrypt_exec_t in the fiorino_decrypt domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`fiorino_decrypt_domtrans',`
	gen_require(`
		type fiorino_decrypt_t, fiorino_decrypt_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, fiorino_decrypt_exec_t, fiorino_decrypt_t)
')

######################################
## <summary>
##	Execute fiorino_decrypt in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`fiorino_decrypt_exec',`
	gen_require(`
		type fiorino_decrypt_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, fiorino_decrypt_exec_t)
')
